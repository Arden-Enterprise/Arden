{
  "name": "@arden/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/indexing/worker-main.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "system-admin:bootstrap": "tsx src/db/bootstrap-system-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/indexing/worker-main.js"
  },
  "dependencies": {
    "@arden/domain": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "nodemailer": "10.0.10",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
