        "op": {
          "const": "apply_filter",
          "title": "Op",
          "type": "string"
        },
        "readerScope": {
          "anyOf": [
            {
              "enum": [
                "ORGANIZATION",
                "DEPARTMENT",
                "SELECTED_MEMBERS",
                "LEGACY_AUDIENCE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Readerscope"
        },
        "typeCode": {
          "anyOf": [
            {
              "enum": [
                "POLICY_AND_STANDARD",
                "PROCEDURE",
                "GUIDE",
                "REFERENCE",
                "LESSONS_LEARNED",
                "UNCATEGORIZED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typecode"
        },
        "validity": {
          "anyOf": [
            {
              "enum": [
                "CURRENT",
                "EXPIRING_SOON"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity"
        }
      },
      "required": [
        "op"
      ],
      "title": "AiApplyFilterAction",
      "type": "object"
    },
