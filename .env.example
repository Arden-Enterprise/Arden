# Local development defaults are built into the API for the Compose database.
# Copy to your shell/environment only when overriding those defaults.
DATABASE_URL=postgresql://arden:arden_dev_only@127.0.0.1:5433/arden
ARDEN_POSTGRES_PORT=5433
ARDEN_API_HOST=127.0.0.1
ARDEN_API_PORT=3001
# Public desktop-client Core origin; desktop launch/build configuration, not an API secret.
ARDEN_CORE_URL=http://127.0.0.1:3001
# Supabase Auth endpoint and publishable/anon key. Keep both in the API environment in this BFF design.
SUPABASE_URL=https://supabase.example.test
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Exact browser origins allowed to use Arden's cookie-authenticated API.
ARDEN_AUTH_TRUSTED_ORIGINS=https://arden.example.test
# Public app origin used to build invitation links; exact origin only (HTTPS in production).
ARDEN_PUBLIC_WEB_ORIGIN=
# Optional SMTP transport for organization invitations. Configure every SMTP field together.
# Gmail (requires an App Password if using password authentication):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=store-this-only-as-a-runtime-secret
# SMTP_FROM=Arden <your-sender@gmail.com>
# Mailjet SMTP relay (use your Mailjet SMTP API key/secret, not your account password):
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-mailjet-smtp-api-key
# SMTP_PASS=store-this-only-as-a-runtime-secret
# SMTP_FROM=Arden <verified-sender@example.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local default is ignored .private/note-content; production must use a persistent private volume.
ARDEN_PRIVATE_STORAGE_ROOT=
# Optional elevated migration connection; production API DATABASE_URL must be a non-bypass runtime login.
ARDEN_MIGRATION_DATABASE_URL=
# Optional real PostgreSQL test target. Must be a disposable, already-migrated arden_test_* database.
ARDEN_TEST_DATABASE_URL=
# Optional live Supabase Auth smoke test. Use a dedicated project and synthetic account.
ARDEN_TEST_SUPABASE_URL=
ARDEN_TEST_SUPABASE_PUBLISHABLE_KEY=
ARDEN_TEST_SUPABASE_EMAIL=
ARDEN_TEST_SUPABASE_PASSWORD=
